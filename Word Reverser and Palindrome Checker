import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        String s = sc.next();
        String rev = new StringBuilder(s).reverse().toString();

        if (s.equals(rev))
            System.out.println(rev + " - palindrome");
        else
            System.out.println(rev + " - not a palindrome");
    }
}
